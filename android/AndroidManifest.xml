<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.alexperez.controltv"
    android:versionCode="10"
    android:versionName="1.9">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Actualizar desde los Releases de GitHub (Ajustes > Actualizar): Android pide confirmar cada instalación. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Asistente de voz: el micrófono del celular se envía a la TV mientras se mantiene pulsado el botón. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 17+ protege la red local; en versiones anteriores se ignora. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Iconos de las apps de streaming instaladas en el celular (se muestran en el panel Aplicaciones). -->
    <queries>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.hbo.hbonow" />
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:label="Control TV"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Compartir" desde otras apps: llega un enlace que la web ofrece enviar a la TV elegida. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Widget: volumen, silencio y pausa sin abrir la app. -->
        <receiver android:name=".WidgetControl" android:exported="true" android:label="Control TV">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_control_info" />
        </receiver>
    </application>
</manifest>
