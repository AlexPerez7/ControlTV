<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="widget_descripcion">Elige tu TV y controla volumen, Inicio o pausa sin abrir la app</string>
    <style name="WidgetTv">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/widget_boton</item>
        <item name="android:textColor">#7CB0FF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:padding">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
    <style name="WidgetBoton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/widget_boton</item>
        <item name="android:textColor">#E8ECF1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
